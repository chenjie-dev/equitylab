# EquityLab 环境变量示例
# 复制：cp .env.example .env
# 说明：docs/2026-10-15-containers.md · docs/2026-10-15-engineering.md

COMPOSE_PROJECT_NAME=equitylab

# --- 数据库 / 缓存 / 向量 ---
# DATABASE_URL / REDIS_URL 供容器内服务互联，主机名用 compose 服务名，勿写 localhost
POSTGRES_DB=equitylab
POSTGRES_USER=equitylab
POSTGRES_PASSWORD=equitylab
POSTGRES_PORT=5432
# 宿主机映射端口；本机 6379 常被占用，默认 16379（容器内仍为 6379）
REDIS_PORT=16379
QDRANT_PORT=6333
DATABASE_URL=postgres://equitylab:equitylab@postgres:5432/equitylab
REDIS_URL=redis://redis:6379

# --- 对外端口（浏览器 / curl 访问） ---
GATEWAY_PORT=3000
FRONTEND_PORT=3001
MARKET_DATA_PORT=3002
GRAFANA_PORT=3003
LOKI_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- 内部服务基址（网关与编排层使用） ---
ORCHESTRATOR_URL=http://orchestrator:8001
RESEARCH_URL=http://research:8002
MARKET_DATA_URL=http://market-data:3002

# --- 外部模型（按需填写；无 Key 时工具链仍可 deterministic 运行） ---
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_CHAT_MODEL=deepseek-chat
EMBEDDING_MODEL=text-embedding-3-large

# 行情库 qdb（同级 ../qdb）。collector 唯一回源；research / market-data 只读。
# 说明：docs/2026-10-20-qdb-行情库.md
QDB_URL=http://qdb:9090
QDB_PORT=9090
QDB_FEED=0
# QDB_FEED_CODES=600519,000001
# 报价热路径间隔（ms）；盘口/RWA 在后台线程另跑
# QDB_FEED_MS=500
# 前端订 qdb snapshots：直连 market-data /qdb/ws（网关不升级 WS）
NEXT_PUBLIC_MARKET_WS_URL=ws://localhost:3002
# mock：本地演示；binance：统一 /quotes /bars 也读 qdb；alphafeed 已拒绝外呼（勿用于读路径）
MARKET_PROVIDER=mock
ALPHAFEED_API_KEY=
ALPHAFEED_BASE_URL=https://api.alphafeed.org/v1
# 币安 / Ondo：仅 collector 回源；读路径走 qdb。
# collector 订币安公开流写入 qdb；market-data /binance/ws 仍是直连代理（可选调试）。
# 默认走 data-api / data-stream（api.binance.com 在部分网络会超时）。
BINANCE_REST_URL=https://data-api.binance.vision
BINANCE_REST_FALLBACK=https://api.binance.com
BINANCE_WS_URL=wss://data-stream.binance.vision
BINANCE_WS_FALLBACK=wss://stream.binance.com:9443
BINANCE_RWA_BASE_URL=https://www.binance.com
# Docker Desktop 容器直连币安出现 SSL WRONG_VERSION_NUMBER 时：
#   1) 宿主机：python3 scripts/host-connect-proxy.py 18080
#   2) 取消下行注释后 recreate collector
# COLLECTOR_HTTPS_PROXY=http://host.docker.internal:18080
# RWA（www.binance.com）与现货出口可分开：Clash 常见 7897 能通 bapi，而 Docker 直连/18080 不通
# COLLECTOR_RWA_PROXY=http://host.docker.internal:7897
# www.binance.com 不可达时关掉 RWA 扫盘，避免拖死 qdb / 代理：
# RWA_WORKERS=0
# RWA_KLINE_WORKERS=0
# 可达后默认已降并发（8/32/4）；可再压：RWA_WORKERS=4 RWA_CHUNK=24 RWA_KLINE_WORKERS=2
# RWA_BOARD_FLUSH_SEC=1.5
# RWA_ENGINE_QUOTES_HOT_ONLY=1
# qdb 写入门闸（现货 high / RWA low 合并刷盘）：
# QDB_WRITE_FLUSH_MS=25
# QDB_WRITE_QUOTE_BATCH=256
# QDB_WRITE_DOC_BATCH=64

# Spot 优先：write_gate 已把现货 quotes 抬到高优先，默认保持 WRITE_QUOTES=1。
# 仅当仍见 /v1/klines 饿死时再临时关掉 trades（图表历史仍走 docs）：
# COLLECTOR_SKIP_ASHARE=1   # 临时应急；=1 时 A 股 REST 热路径与 backfill 全停，/markets/ashare 与 qdb SSE:* 会空。日常本地开发保持未设置或 =0，改完后 recreate collector
# BINANCE_WS_WRITE_TRADES=0
# BINANCE_WS_WRITE_QUOTES=0   # 不推荐；snapshots 订阅读会空
# BINANCE_KLINE_INTERVALS=1m,5m,15m,1h,4h,1d
# BINANCE_KLINE_LIMIT=180
# # docs 硬顶 500；只覆盖最近 N 根，不与旧数据合并
# # 时间窗：不保留 15 天前的 docs K 线（写入裁剪 + 定时 GC）
# QDB_RETENTION_DAYS=15
# QDB_RETENTION_GC_SEC=3600
# RWA_KLINE_LIMIT=200
# BINANCE_KLINE_PAUSE_SEC=2
# BINANCE_KLINE_BACKFILL=0
# BINANCE_KLINE_WRITE_TRADES=0

# --- 网关治理（可选） ---
# RATE_LIMIT_PER_MINUTE=120
