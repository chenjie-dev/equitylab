# EquityLab 环境变量示例
# 复制：cp .env.example .env
# 说明：docs/2026-10-15-containers.md · docs/2026-10-15-engineering.md

COMPOSE_PROJECT_NAME=equitylab

# --- 数据库 / 缓存 / 向量 ---
# DATABASE_URL / REDIS_URL 供容器内服务互联，主机名用 compose 服务名，勿写 localhost
POSTGRES_DB=equitylab
POSTGRES_USER=equitylab
POSTGRES_PASSWORD=equitylab
POSTGRES_PORT=5432
# 宿主机映射端口；本机 6379 常被占用，默认 16379（容器内仍为 6379）
REDIS_PORT=16379
QDRANT_PORT=6333
DATABASE_URL=postgres://equitylab:equitylab@postgres:5432/equitylab
REDIS_URL=redis://redis:6379

# --- 对外端口（浏览器 / curl 访问） ---
GATEWAY_PORT=3000
FRONTEND_PORT=3001
MARKET_DATA_PORT=3002
GRAFANA_PORT=3003
LOKI_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- 内部服务基址（网关与编排层使用） ---
ORCHESTRATOR_URL=http://orchestrator:8001
RESEARCH_URL=http://research:8002
MARKET_DATA_URL=http://market-data:3002

# --- 外部模型（按需填写；无 Key 时工具链仍可 deterministic 运行） ---
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_CHAT_MODEL=deepseek-chat
EMBEDDING_MODEL=text-embedding-3-large

# 行情库 qdb（同级 ../qdb）。collector 唯一回源；research / market-data 只读。
# 说明：docs/2026-10-20-qdb-行情库.md
QDB_URL=http://qdb:9090
QDB_PORT=9090
QDB_FEED=0
# QDB_FEED_CODES=600519,000001
# 报价热路径间隔（ms）；盘口/RWA 在后台线程另跑
# QDB_FEED_MS=500
# 前端订 qdb snapshots：直连 market-data /qdb/ws（网关不升级 WS）
NEXT_PUBLIC_MARKET_WS_URL=ws://localhost:3002
# mock：本地演示；binance：统一 /quotes /bars 也读 qdb；alphafeed：需 ALPHAFEED_API_KEY
MARKET_PROVIDER=mock
ALPHAFEED_API_KEY=
ALPHAFEED_BASE_URL=https://api.alphafeed.org/v1
# 币安 / Ondo：仅 collector 回源；读路径走 qdb。
# collector 订币安公开流写入 qdb；market-data /binance/ws 仍是直连代理（可选调试）。
BINANCE_REST_URL=https://api.binance.com
BINANCE_REST_FALLBACK=https://data-api.binance.vision
BINANCE_WS_URL=wss://data-stream.binance.vision
BINANCE_WS_FALLBACK=wss://stream.binance.com:9443
BINANCE_RWA_BASE_URL=https://www.binance.com

# --- 网关治理（可选） ---
# RATE_LIMIT_PER_MINUTE=120
