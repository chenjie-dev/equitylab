    {
      "type": "stat",
      "title": "qdb write errors/s",
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(equitylab_qdb_write_errors_total[5m])",
