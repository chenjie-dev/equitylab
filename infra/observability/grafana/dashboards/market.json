          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "停滞" },
                "1": { "text": "在动" }
              }
            }
          ]
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
